{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-agent-factory.local/schemas/project-blueprint.schema.json",
  "title": "Project Agent Factory blueprint",
  "type": "object",
  "required": ["schemaVersion", "project", "policies", "qualityCriteria", "sources"],
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "location", "authority", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
        "location": { "type": "string", "minLength": 1 },
        "authority": { "enum": ["canonical", "supporting", "informational", "unknown"] },
        "status": { "enum": ["user-confirmed", "observed", "inferred", "unknown"] },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["name", "slug", "kind", "summary", "workingLanguage"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": {
          "enum": ["software", "analysis", "research", "legal", "documentation", "audit", "product", "operations", "mixed"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "workingLanguage": { "type": "string", "minLength": 2 },
        "domain": { "type": "string" },
        "artifactTypes": { "type": "array", "items": { "type": "string" } },
        "capabilityPacks": {
          "type": "array",
          "items": { "enum": ["coding", "research", "documentation", "source-verification", "design", "security", "release"] },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "policies": {
      "type": "object",
      "required": ["communicationLanguage", "writeApproval", "confidentiality", "sourceCitation", "delegation"],
      "properties": {
        "communicationLanguage": { "type": "string", "minLength": 2 },
        "writeApproval": { "enum": ["explicit", "task-scoped"] },
        "confidentiality": { "enum": ["public", "internal", "confidential", "restricted"] },
        "sourceCitation": { "enum": ["required", "recommended", "optional"] },
        "delegation": { "enum": ["disabled", "read-only", "task-scoped"] }
      },
      "additionalProperties": false
    },
    "qualityCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "commands": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "openQuestions": { "type": "array", "items": { "type": "string" } },
    "codex": {
      "type": "object",
      "properties": {
        "agentModel": { "type": "string" },
        "agentReasoningEffort": { "enum": ["low", "medium", "high", "xhigh"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
