{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-agent-factory.local/schemas/bdd-conversion.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": [
        "needs-clarification",
        "ready"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "source-authority",
              "roles-and-state",
              "data-and-variants",
              "actions-and-outcomes",
              "observable-oracles",
              "isolation-and-cleanup",
              "terminology-and-ui",
              "traceability"
            ]
          },
          "status": {
            "enum": [
              "confirmed",
              "not-applicable",
              "unresolved"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 8,
      "maxItems": 8
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "source",
          "line",
          "question",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "confirmedBy": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "questionId",
          "answer",
          "confirmedBy"
        ],
        "additionalProperties": false
      }
    },
    "technicalDraft": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[^\\\\]+\\.feature$"
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "traceability": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "technicalLine": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "source",
                "line",
                "technicalLine"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "path",
          "content",
          "traceability"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "sources",
    "checks",
    "questions",
    "decisions",
    "technicalDraft"
  ],
  "additionalProperties": false
}
